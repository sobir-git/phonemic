#!/usr/bin/env bash
# phonemic - use an Android phone as a microphone for this laptop.
# Transports: USB, LAN (Wi-Fi), or Tailscale (over the internet).

set -u

PREFIX="$HOME/.local/share/phonemic"
SCRCPY_DIR="$PREFIX/scrcpy"
SCRCPY="$SCRCPY_DIR/scrcpy"
CONF_DIR="$HOME/.config/phonemic"
CONF="$CONF_DIR/config"
PW_CONF="$HOME/.config/pipewire/pipewire.conf.d/50-phonemic.conf"
PP_CONF="$HOME/.config/pipewire/pipewire-pulse.conf.d/50-phonemic.conf"
STATE="${XDG_RUNTIME_DIR:-/tmp}/phonemic"
PIDFILE="$STATE/pid1"
LOGFILE="$STATE/log1"

ADB_PORT=5555

# Two slots so two phones can be used simultaneously:
#   slot 1 -> "PhoneMic"   (USB / adb phone)
#   slot 2 -> "PhoneMic 2" (network phone, no adb)
SLOT=1; SINK="phonemic"; SRC="phonemic_src"; LABEL="PhoneMic"
WEB_UNIT="phonemic-web.service"
web_unit_installed() { systemctl --user cat "$WEB_UNIT" >/dev/null 2>&1; }
web_unit_active()    { [ "$(systemctl --user is-active "$WEB_UNIT" 2>/dev/null)" = active ]; }
use_slot() {
  SLOT="${1:-1}"
  case "$SLOT" in
    2) SINK="phonemic2"; SRC="phonemic2_src"; LABEL="PhoneMic-2" ;;
    *) SLOT=1; SINK="phonemic";  SRC="phonemic_src";  LABEL="PhoneMic" ;;
  esac
  PIDFILE="$STATE/pid$SLOT"; LOGFILE="$STATE/log$SLOT"
}

mkdir -p "$STATE" "$CONF_DIR"

# ---------- pretty ----------
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  B=$'\e[1m'; DIM=$'\e[2m'; R=$'\e[31m'; G=$'\e[32m'; Y=$'\e[33m'; C=$'\e[36m'; Z=$'\e[0m'
else B=""; DIM=""; R=""; G=""; Y=""; C=""; Z=""; fi

say()  { printf '%s\n' "$*"; }
ok()   { printf '%s  ✓%s %s\n' "$G" "$Z" "$*"; }
warn() { printf '%s  !%s %s\n' "$Y" "$Z" "$*"; }
bad()  { printf '%s  ✗%s %s\n' "$R" "$Z" "$*"; }
info() { printf '%s  ·%s %s\n' "$DIM" "$Z" "$*"; }
head1(){ printf '\n%s%s%s\n' "$B" "$*" "$Z"; }
die()  { bad "$*"; exit 1; }
pause(){ printf '\n%s    press Enter when done ›%s ' "$C" "$Z"; read -r _ </dev/tty; }

notify() { command -v notify-send >/dev/null && notify-send -a phonemic "$1" "${2:-}" 2>/dev/null; }

# ---------- config ----------
load_conf() { TRANSPORT=""; ADDR=""; AUDIO_SOURCE=""; BUFFER=""; SEEDED=0; NET_URL=""; ADDR2=""; WEB_HOST=""; [ -f "$CONF" ] && . "$CONF"; }
save_conf() {
  cat > "$CONF" <<EOF
TRANSPORT="${TRANSPORT:-}"
ADDR="${ADDR:-}"
AUDIO_SOURCE="${AUDIO_SOURCE:-}"
BUFFER="${BUFFER:-50}"
SEEDED="${SEEDED:-0}"
NET_URL="${NET_URL:-}"
ADDR2="${ADDR2:-}"
WEB_HOST="${WEB_HOST:-}"
EOF
}

# ---------- adb ----------
# Pin to ONE adb. The scrcpy tarball ships its own (different version) and two
# versions will repeatedly kill each other's server. Prefer the system one.
find_adb() {
  if command -v adb >/dev/null; then ADB="$(command -v adb)"
  elif [ -x "$HOME/Android/Sdk/platform-tools/adb" ]; then ADB="$HOME/Android/Sdk/platform-tools/adb"
  elif [ -x "$SCRCPY_DIR/adb" ]; then ADB="$SCRCPY_DIR/adb"
  else return 1; fi
  export ADB
}

adb_usb_serial() {
  "$ADB" devices 2>/dev/null | awk 'NR>1 && $2=="device" && $1 !~ /:/ {print $1; exit}'
}
adb_usb_serials() {
  "$ADB" devices 2>/dev/null | awk 'NR>1 && $2=="device" && $1 !~ /:/ {print $1}'
}

# With two phones cabled we must not silently grab the wrong one.
pick_usb_device() {
  local list n i=1 sel model
  list=$(adb_usb_serials); n=$(printf '%s\n' "$list" | grep -c . )
  [ "$n" -eq 0 ] && return 1
  if [ "$n" -eq 1 ]; then printf '%s' "$list"; return 0; fi
  {
    say ""
    say "  ${B}More than one phone is plugged in:${Z}"
    while read -r sv; do
      [ -n "$sv" ] || continue
      model=$("$ADB" -s "$sv" shell getprop ro.product.model 2>/dev/null | tr -d '\r')
      say "    $i) ${model:-unknown}  ($sv)"
      i=$((i+1))
    done <<EOF2
$list
EOF2
    printf '%s  which one? [1-%d] ›%s ' "$C" "$n" "$Z"
  } >&2
  read -r sel </dev/tty
  printf '%s\n' "$list" | sed -n "${sel:-1}p"
}

adb_any_serial() {
  "$ADB" devices 2>/dev/null | awk 'NR>1 && $2=="device" {print $1; exit}'
}

device_sdk() {
  "$ADB" -s "$1" shell getprop ro.build.version.sdk 2>/dev/null | tr -d '\r'
}

screen_locked() {
  local d; d=$("$ADB" -s "$1" shell dumpsys window 2>/dev/null | tr -d '\r')
  case "$d" in *isKeyguardShowing=true*) return 0 ;; *) return 1 ;; esac
}

# Measured 2026-09-08: Tailscale's Android client is OUTBOUND ONLY. It accepts
# no inbound TCP to anything on the device -- not adbd, not an app's HTTP
# server, not even Tailscale's own peerapi. `tailscale ping` still answers
# because that is handled inside the Tailscale app itself, so reachability
# there proves nothing about TCP. Any design where the laptop connects TO an
# Android phone over the tailnet cannot work; the phone must connect out.
android_inbound_note() {
  say ""
  say "  ${B}Why this cannot work over Tailscale:${Z}"
  say "  Tailscale on Android is outbound-only -- it accepts no incoming"
  say "  connections to anything on the phone. Confirmed by direct test:"
  say "  a plain listener on the phone, and Tailscale's own peer API, are"
  say "  both unreachable while ${B}tailscale ping${Z} answers normally."
  say ""
  say "  This is a limit of Tailscale's Android client, not of your setup,"
  say "  and no amount of seeding or port-opening changes it."
  say ""
  say "  ${B}Over the internet the phone must connect out to this laptop.${Z}"
  say "  Over the same Wi-Fi, laptop-to-phone works fine: use ${B}phonemic pair${Z}."
}

tailscale_android() {
  command -v tailscale >/dev/null || return 1
  tailscale status --json 2>/dev/null | jq -r '
    .Peer // {} | to_entries[] | .value
    | select(.OS=="android")
    | [(.TailscaleIPs[0] // ""), (.HostName // "phone"), (if .Online then "online" else "offline" end),
       (if .Relay=="" then "direct" else "relay:"+.Relay end)] | @tsv' 2>/dev/null
}

# ---------- dependency install ----------
scrcpy_ok() {
  [ -x "$SCRCPY" ] || return 1
  local h; h=$("$SCRCPY" --help 2>&1)
  case "$h" in *mic-unprocessed*|*'"mic"'*) return 0 ;; *) return 1 ;; esac
}

install_scrcpy() {
  if scrcpy_ok; then
    ok "scrcpy $("$SCRCPY" --version 2>/dev/null | head -1 | awk '{print $2}') already installed"
    return 0
  fi
  info "Ubuntu's packaged scrcpy is too old to capture the microphone."
  info "Fetching an official prebuilt build instead (no root, no PPA)…"
  local tag url tmp
  tag=$(curl -fsSL https://api.github.com/repos/Genymobile/scrcpy/releases/latest | jq -r .tag_name) || return 1
  [ -n "$tag" ] && [ "$tag" != null ] || return 1
  url="https://github.com/Genymobile/scrcpy/releases/download/${tag}/scrcpy-linux-x86_64-${tag}.tar.gz"
  tmp=$(mktemp -d)
  curl -fSL --progress-bar -o "$tmp/s.tgz" "$url" || { rm -rf "$tmp"; return 1; }
  rm -rf "$SCRCPY_DIR"; mkdir -p "$SCRCPY_DIR"
  tar xzf "$tmp/s.tgz" -C "$SCRCPY_DIR" --strip-components=1 || { rm -rf "$tmp"; return 1; }
  rm -rf "$tmp"
  scrcpy_ok || return 1
  ok "scrcpy $tag installed to $SCRCPY_DIR"
}

# Pick the best mic source this scrcpy actually supports (names changed across
# versions -- probe, never hardcode).
pick_audio_source() {
  local help; help=$("$SCRCPY" --help 2>&1)
  for s in mic-unprocessed mic-voice-recognition mic; do
    case "$help" in *"\"$s\""*) echo "$s"; return ;; esac
  done
  echo mic
}

# ---------- virtual microphone ----------
vmic_present() { pactl list sources short 2>/dev/null | grep -q "$SRC"; }
vmic_all_present() {
  pactl list sources short 2>/dev/null | grep -q phonemic_src &&
  pactl list sources short 2>/dev/null | grep -q phonemic2_src
}

audio_server_ok() {
  local info; info=$(pactl info 2>/dev/null)
  case "$info" in
    *PipeWire*) return 0 ;;
    "") bad "no PulseAudio/PipeWire server is running"; return 1 ;;
    *) bad "this tool needs PipeWire; this system runs classic PulseAudio."
       info "The virtual microphone is created with PipeWire drop-in configs."
       return 1 ;;
  esac
}

install_vmic() {
  audio_server_ok || return 1
  if vmic_all_present; then ok "virtual microphones \"PhoneMic\" + \"PhoneMic-2\" already present"; return 0; fi
  mkdir -p "$(dirname "$PW_CONF")" "$(dirname "$PP_CONF")"

  # The sink half lives in pipewire; the source half is a pulse remap-source.
  # (A native Audio/Source/Virtual loopback fails with -28 / EIO on
  # PipeWire 1.0.x, so the pulse path is deliberate, not laziness.)
  cat > "$PW_CONF" <<'EOF'
# Managed by `phonemic`. Silent sinks that the phone audio is played into.
# Two of them, so two phones can be used at the same time.
context.objects = [
  { factory = adapter
    args = {
      factory.name     = support.null-audio-sink
      node.name        = "phonemic"
      node.description = "PhoneMic (sink)"
      media.class      = Audio/Sink
      audio.position   = [ FL FR ]
    }
  }
  { factory = adapter
    args = {
      factory.name     = support.null-audio-sink
      node.name        = "phonemic2"
      node.description = "PhoneMic 2 (sink)"
      media.class      = Audio/Sink
      audio.position   = [ FL FR ]
    }
  }
]
EOF

  cat > "$PP_CONF" <<'EOF'
# Managed by `phonemic`. Half two of two: exposes the sink's monitor as a real
# input device named "PhoneMic", so apps can select it once and keep it
# selected whether or not phonemic is streaming. Silent when idle.
pulse.cmd = [
  { cmd = "load-module"
    args = "module-remap-source master=phonemic.monitor source_name=phonemic_src source_properties=device.description=PhoneMic"
  }
  { cmd = "load-module"
    args = "module-remap-source master=phonemic2.monitor source_name=phonemic2_src source_properties=device.description=PhoneMic-2"
  }
]
EOF

  info "restarting PipeWire (audio will blip for a second)…"
  systemctl --user restart pipewire pipewire-pulse wireplumber 2>/dev/null
  for _ in $(seq 1 24); do vmic_all_present && break; sleep 0.25; done

  if ! vmic_all_present; then
    bad "the virtual microphone did not come up -- rolling back so your audio keeps working"
    rm -f "$PW_CONF" "$PP_CONF"
    systemctl --user restart pipewire pipewire-pulse wireplumber 2>/dev/null
    sleep 1
    bad "rolled back. Your normal sound is unaffected. Run: phonemic doctor"
    return 1
  fi
  ok "virtual microphones \"PhoneMic\" + \"PhoneMic-2\" created (permanent)"
}

