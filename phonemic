cmd_phone() {
  phone_steps_dev; phone_steps_usb; phone_steps_wifi; phone_steps_tailscale
  echo
}

# ---------- connection ----------
# Seed a FIXED adb port over USB. This persists until the phone reboots and
# works identically on LAN and over Tailscale -- no random port to read off
# the phone screen, and no mDNS (which never crosses a tailnet).
seed_tcpip() {
  local serial="$1" i
  "$ADB" -s "$serial" tcpip "$ADB_PORT" >/dev/null 2>&1 || return 1
  # `adb tcpip` returns BEFORE adbd actually restarts, so the device is still
  # briefly visible. Sleep past the drop first, or wait-for-device returns
  # instantly on a connection that is about to die and scrcpy launches into
  # the gap with "Could not find any ADB device".
  sleep 2
  "$ADB" -s "$serial" wait-for-device >/dev/null 2>&1
  for i in $(seq 1 24); do
    "$ADB" devices 2>/dev/null | grep -q "^${serial}[[:space:]]*device" && return 0
    sleep 0.5
  done
  return 1
}

try_connect() {
  local addr="$1"
  timeout 8 "$ADB" connect "$addr" 2>&1 | grep -qE 'connected to' && return 0
  return 1
}

# Resolve a usable device.
#   prefer=usb    -> cabled phone first (slot 1)
#   prefer=remote -> never USB; the tailnet/Wi-Fi phone only (slot 2)
resolve_device() {
  DEV=""; VIA=""
  local prefer="${1:-usb}" s ip name online relay

  if [ "$prefer" = remote ]; then
    if [ -n "${ADDR2:-}" ] && try_connect "$ADDR2"; then
      DEV="$ADDR2"; case "$ADDR2" in 100.*) VIA="Tailscale";; *) VIA="Wi-Fi";; esac; return 0
    fi
    while IFS=$'\t' read -r ip name online relay; do
      [ -n "$ip" ] || continue
      if try_connect "$ip:$ADB_PORT"; then
        DEV="$ip:$ADB_PORT"; VIA="Tailscale"; ADDR2="$DEV"; save_conf; return 0
      fi
    done < <(tailscale_android)
    return 1
  fi

  s=$(adb_usb_serial)
  if [ -n "$s" ]; then
    if [ "$(adb_usb_serials | grep -c .)" -gt 1 ]; then
      warn "several phones are cabled; using $s. Unplug the others to change that."
    fi
    DEV="$s"; VIA="USB"; return 0
  fi

  if [ -n "${ADDR:-}" ] && try_connect "$ADDR"; then
    DEV="$ADDR"
    case "$ADDR" in 100.*) VIA="Tailscale";; *) VIA="Wi-Fi";; esac
    return 0
  fi

  local m
  m=$("$ADB" mdns services 2>/dev/null | awk '/_adb-tls-connect/ {print $3; exit}')
  if [ -n "$m" ] && try_connect "$m"; then DEV="$m"; VIA="Wi-Fi"; ADDR="$m"; return 0; fi

  local ip name online
  while IFS=$'\t' read -r ip name online _; do
    [ -n "$ip" ] || continue
    if try_connect "$ip:$ADB_PORT"; then
      DEV="$ip:$ADB_PORT"; VIA="Tailscale"; ADDR="$DEV"; return 0
    fi
  done < <(tailscale_android)
  return 1
}

# ---------- audio routing ----------
find_sink_input() {  # $1 = pid -> "<sink-input-id> <sink-id>"
  pactl list sink-inputs 2>/dev/null | awk -v pid="$1" '
    /^Sink Input #/ { if (m && id!="") { print id, sk; exit } id=substr($3,2); sk=""; m=0 }
    /^[ \t]*Sink: / { sk=$2 }
    /application\.process\.id = / { v=$3; gsub(/"/,"",v); if (v==pid) m=1 }
    tolower($0) ~ /application\.name = .*scrcpy/ { m=1 }
    END { if (m && id!="") print id, sk }'
}

sink_name_of() { pactl list sinks short | awk -v i="$1" '$1==i {print $2}'; }

# Move the stream onto the virtual mic. PULSE_SINK is only advisory -- SDL may
# use its native PipeWire backend and ignore it, sending your voice to the
# speakers instead. Returns 2 if no stream ever appeared.
route_stream() {
  local pid="$1" si id sk name i
  for i in $(seq 1 40); do
    si=$(find_sink_input "$pid"); [ -n "$si" ] && break
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.25
  done
  [ -n "$si" ] || return 2
  id=${si%% *}; sk=${si##* }
  name=$(sink_name_of "$sk")
  if [ "$name" != "$SINK" ]; then
    pactl move-sink-input "$id" "$SINK" >/dev/null 2>&1
    sleep 0.5
    si=$(find_sink_input "$pid"); sk=${si##* }
    name=$(sink_name_of "$sk")
  fi
  ROUTED_TO="$name"
  [ "$name" = "$SINK" ]
}

# ---------- run ----------
running() {
  [ -f "$PIDFILE" ] || return 1
  local pid cmd; pid=$(cat "$PIDFILE" 2>/dev/null)
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null || { rm -f "$PIDFILE"; return 1; }
  # guard against PID reuse: the pid must still be one of ours
  cmd=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)
  case "$cmd" in *scrcpy*|*ffmpeg*|*webmic.py*) return 0 ;; *) rm -f "$PIDFILE"; return 1 ;; esac
}

cmd_off() {
  local target="${1:-}" any=0 sl
  for sl in 1 2; do
    [ -n "$target" ] && [ "$target" != "$sl" ] && continue
    use_slot "$sl"
    if [ "$sl" = 2 ] && web_unit_active; then
      systemctl --user stop "$WEB_UNIT"
      ok "$LABEL off ${DIM}(service stopped)${Z}"; notify "$LABEL" "off"; any=1
      continue
    fi
    if running; then
      local pid pgid; pid=$(cat "$PIDFILE")
      # Kill the whole process group when the process leads one, so children
      # (the per-connection ffmpeg) die with it rather than keeping the mic hot.
      pgid=$(ps -o pgid= -p "$pid" 2>/dev/null | tr -d ' ')
      if [ -n "$pgid" ] && [ "$pgid" = "$pid" ]; then
        kill -- "-$pid" 2>/dev/null
        # escalate if it ignores TERM: a mic that will not switch off is worse
        # than one that will not switch on
        local w; for w in 1 2 3 4 5 6; do kill -0 "$pid" 2>/dev/null || break; sleep 0.25; done
        kill -0 "$pid" 2>/dev/null && kill -9 -- "-$pid" 2>/dev/null
      else
        kill "$pid" 2>/dev/null
        local w; for w in 1 2 3 4; do kill -0 "$pid" 2>/dev/null || break; sleep 0.25; done
        kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null
      fi
      rm -f "$PIDFILE"
      ok "$LABEL off"; notify "$LABEL" "off"; any=1
    fi
  done
  [ "$any" = 0 ] && info "nothing was running"
  return 0
}

cmd_on() {
  load_conf; use_slot "${1:-1}"
  local prefer=usb; [ "$SLOT" = 2 ] && prefer=remote
  running && { warn "$LABEL already running"; return 0; }
  find_adb || die "adb not found. Run: phonemic setup"
  scrcpy_ok || die "scrcpy not installed. Run: phonemic setup"
  vmic_present || die "virtual microphone missing. Run: phonemic setup"

  if ! resolve_device "$prefer"; then
    if [ "$prefer" = remote ]; then
      bad "the remote phone is not reachable on port $ADB_PORT."
      case "${ADDR2:-}" in
        100.*|"") android_inbound_note ;;
        *) say "  On the same Wi-Fi, seed it once over USB: ${B}phonemic seed${Z}" ;;
      esac
    else
      bad "no phone found."
      info "Plug in over USB, or run:  ${B}phonemic doctor${Z}"
    fi
    return 1
  fi

  # Opportunistically seed the fixed wireless port whenever we're on USB, so
  # cable-free use works later without touching the phone.
  if [ "$VIA" = "USB" ] && [ "$SLOT" = 1 ] && [ "${SEEDED:-0}" != 1 ]; then
    info "first USB run: enabling cable-free use on port $ADB_PORT…"
    if seed_tcpip "$DEV"; then SEEDED=1; else warn "could not enable the wireless port (cable still works)"; fi
    local lan; lan=$("$ADB" -s "$DEV" shell ip route 2>/dev/null | awk '/src/ {print $NF; exit}' | tr -d '\r')
    [ -n "$lan" ] && { ADDR="$lan:$ADB_PORT"; info "wireless address saved: $ADDR"; }
  fi
  save_conf

  launch() {
    : > "$LOGFILE"
    # PULSE_SINK is advisory: SDL may use its native PipeWire backend and
    # ignore it, which sends your voice to the speakers instead. We ask nicely
    # here and then move the stream explicitly below.
    PULSE_SINK="$SINK" SDL_AUDIODRIVER=pulseaudio ADB="$ADB" nohup "$SCRCPY" \
        --serial "$DEV" \
        --no-video --no-window --no-control \
        --audio-source="$1" \
        --audio-buffer="${BUFFER:-50}" \
        >>"$LOGFILE" 2>&1 &
    echo $! > "$PIDFILE"
    sleep 3
    running && ! grep -qi 'Failed to start audio capture' "$LOGFILE"
  }

  # Android 11 and older refuse mic capture from a locked screen. Say so up
  # front instead of letting the launch fail with a cryptic server error.
  local sdk; sdk=$(device_sdk "$DEV")
  if [ -n "$sdk" ] && [ "$sdk" -le 30 ] 2>/dev/null && screen_locked "$DEV"; then
    warn "This phone (Android SDK $sdk) needs its screen ${B}unlocked${Z} to share the mic."
    if [ -t 0 ]; then
      printf '%s    unlock it, then press Enter ›%s ' "$C" "$Z"; read -r _ </dev/tty
    fi
  fi

  # Probe for the best source the first time; only a real refusal downgrades it.
  [ -n "${AUDIO_SOURCE:-}" ] || { AUDIO_SOURCE=$(pick_audio_source); save_conf; }
  local src="$AUDIO_SOURCE"
  if ! launch "$src"; then
    # Android 11 refuses audio capture unless the screen is unlocked.
    if grep -qi 'must be started in the foreground\|device is unlocked' "$LOGFILE"; then
      cmd_off >/dev/null 2>&1
      warn "Your phone refused to share its microphone because the screen is locked."
      say  "    ${B}Unlock the phone now${Z} (Android 11 requires this; newer versions don't)."
      if [ -t 0 ]; then
        printf '%s    press Enter once it is unlocked ›%s ' "$C" "$Z"; read -r _ </dev/tty
        launch "$src" || true
      fi
    fi
    # Some devices reject the fancier sources even when scrcpy offers them.
    if ! running && [ "$src" != mic ]; then
      warn "'$src' was refused by the phone -- falling back to plain mic"
      AUDIO_SOURCE=mic; src=mic; save_conf
      launch mic || true
    fi
  fi

  if ! running; then
    bad "could not start. Last lines:"
    grep -i 'error\|warn' "$LOGFILE" | head -4 | sed 's/^/      /'
    rm -f "$PIDFILE"; return 1
  fi

  ROUTED_TO=""
  route_stream "$(cat "$PIDFILE")"
  case $? in
    0) ok "routed to the virtual microphone" ;;
    2) warn "no audio stream appeared -- the phone may not be sharing its mic" ;;
    *) warn "could not route the audio to PhoneMic (it is on '${ROUTED_TO:-unknown}')."
       warn "Fix manually: pavucontrol → Playback → scrcpy → 'PhoneMic (sink)'" ;;
  esac

  ok "$LABEL ${B}on${Z}  ${DIM}via $VIA · source ${AUDIO_SOURCE:-mic} · buffer ${BUFFER:-50}ms${Z}"
  info "Select ${B}$LABEL${Z} as the input device in your app."
  notify "$LABEL on" "via $VIA"
}

cmd_toggle() { use_slot 1; if running; then cmd_off 1; else cmd_on; fi; }

# ---------- status / doctor ----------
cmd_status() {
  load_conf; find_adb
  head1 "Microphones"
  local sl
  for sl in 1 2; do
    use_slot "$sl"
    if running; then ok "$LABEL: ${B}streaming${Z} (pid $(cat "$PIDFILE"))"
    elif vmic_present; then info "$LABEL: idle (device present, silent)"
    else bad "$LABEL: missing -- run: phonemic setup"; fi
  done
  use_slot 1
  if web_unit_installed; then
    if web_unit_active; then ok "web service: active ${DIM}($(systemctl --user is-enabled "$WEB_UNIT" 2>/dev/null) at boot)${Z}"
    else info "web service: stopped ${DIM}(phonemic web to start)${Z}"; fi
    [ -n "${WEB_HOST:-}" ] && info "public host: $WEB_HOST"
  fi
  scrcpy_ok && ok "scrcpy $("$SCRCPY" --version 2>/dev/null | head -1 | awk '{print $2}')" || bad "scrcpy missing"
  [ -n "${ADDR:-}" ] && info "last address: $ADDR"

  head1 "Phone over Tailscale"
  local found=0 ip name online relay
  while IFS=$'\t' read -r ip name online relay; do
    found=1
    if [ "$online" = online ]; then ok "$name  $ip  $relay"; else bad "$name  $ip  offline"; fi
    if [ "$relay" != direct ] && [ "$online" = online ]; then
      warn "relayed, not a direct connection -- expect noticeably more latency"
    fi
  done < <(tailscale_android)
  [ "$found" = 0 ] && info "no Android device on your tailnet"
  echo
}

cmd_doctor() {
  head1 "Checking your laptop"
  find_adb && ok "adb: $ADB" || bad "adb not found -- run: phonemic setup"
  scrcpy_ok && ok "scrcpy ok ($(pick_audio_source) available)" || bad "scrcpy missing/too old -- run: phonemic setup"
  vmic_present && ok "virtual microphone present" || bad "virtual microphone missing -- run: phonemic setup"
  command -v tailscale >/dev/null && ok "tailscale installed" || info "tailscale not installed (only needed for internet use)"

  head1 "Looking for your phone"
  find_adb || return 1
  local s; s=$(adb_usb_serial)
  if [ -n "$s" ]; then ok "found over USB ($s)"; else info "nothing on USB"; fi

  local ip name online relay
  while IFS=$'\t' read -r ip name online relay; do
    if [ "$online" != online ]; then
      bad "$name is offline on the tailnet"
      warn "Android killed Tailscale in the background. Fix on the phone:"
      phone_steps_tailscale
      continue
    fi
    ok "$name online at $ip ($relay)"
    printf '  · probing adb on %s:%s … ' "$ip" "$ADB_PORT"
    if try_connect "$ip:$ADB_PORT"; then
      printf '%sreachable%s\n' "$G" "$Z"
      ADDR="$ip:$ADB_PORT"; load_conf 2>/dev/null; ADDR="$ip:$ADB_PORT"; save_conf
    else
      printf '%sno%s\n' "$Y" "$Z"
      android_inbound_note
    fi
  done < <(tailscale_android)
  echo
}

cmd_test() {
  use_slot "${1:-1}"
  vmic_present || die "$LABEL missing. Run: phonemic setup"
  running || warn "$LABEL is not streaming -- you'll see silence."
  say "  Metering ${B}$LABEL${Z}"
  say ""
  say "${B}Speak normally.${Z} Aim the ${B}bottom edge${Z} of the phone at your mouth,"
  say "about 20cm away. Ctrl-C to stop."
  say ""
  parec --device="${SRC}" --format=s16le --rate=16000 --channels=1 2>/dev/null | python3 -u -c '
import sys, struct, math
W=50
while True:
    b=sys.stdin.buffer.read(3200)
    if not b: break
    n=len(b)//2
    if not n: continue
    v=struct.unpack("<%dh"%n,b[:n*2])
    rms=math.sqrt(sum(x*x for x in v)/n)
    db=20*math.log10(rms/32768) if rms>0 else -90
    lvl=max(0.0,min(1.0,(db+60)/60))
    f=int(lvl*W)
    if db>-3: c,t="\033[31m","CLIPPING"
    elif db>-12: c,t="\033[32m","good"
    elif db>-30: c,t="\033[33m","quiet - move closer"
    else: c,t="\033[2m","silent"
    sys.stdout.write("\r  %s%-*s\033[0m %6.1f dB  %-18s"%(c,W,"#"*f,db,t))
    sys.stdout.flush()
'
}

# ---------- web mic: the phone's browser pushes audio to us ----------
# The only design that works over the internet, because Tailscale's Android
# client will not accept inbound connections (see android_inbound_note).
TS_NAME=""
ts_dns_name() {
  tailscale status --json 2>/dev/null | jq -r '.Self.DNSName // ""' 2>/dev/null | sed 's/\.$//'
}
ts_self_ip() {
  tailscale status --json 2>/dev/null | jq -r '.Self.TailscaleIPs[0] // ""' 2>/dev/null
}

cmd_web() {
  load_conf; use_slot "${1:-2}"
  command -v ffmpeg >/dev/null || die "ffmpeg is required (sudo apt install ffmpeg)"
  python3 -c "import websockets" 2>/dev/null || die "python websockets missing (pip install websockets)"
  vmic_present || die "$LABEL missing. Run: phonemic setup"
  running && { warn "$LABEL already running -- restarting"; cmd_off "$SLOT" >/dev/null; use_slot "$SLOT"; }

  if web_unit_installed; then
    systemctl --user start "$WEB_UNIT" || die "could not start $WEB_UNIT"
    local h
    h="${WEB_HOST:-}"
    say ""
    ok "$LABEL ${B}running${Z} ${DIM}(systemd service, starts on boot)${Z}"
    say ""
    if [ -n "$h" ]; then
      say "  ${B}Open on any phone, anywhere:${Z}"
      say "  ${C}https://$h/${Z}"
    else
      say "  ${DIM}No public hostname configured yet.${Z}"
      say "  Reachable on this machine at http://127.0.0.1:8444/"
    fi
    say ""
    info "First visit: run ${B}phonemic browser pair${Z} and enter the code on the phone."
    info "Stop with ${B}phonemic off 2${Z} · logs: ${B}journalctl --user -u $WEB_UNIT -f${Z}"
    return 0
  fi

  local name ip crt key port=8444
  name=$(ts_dns_name); ip=$(ts_self_ip)
  [ -n "$name" ] && [ -n "$ip" ] || die "Tailscale is not up on this laptop"
  mkdir -p "$PREFIX/certs"; chmod 700 "$PREFIX/certs" 2>/dev/null
  crt="$PREFIX/certs/$name.crt"; key="$PREFIX/certs/$name.key"

  # getUserMedia needs a secure context; tailscale cert gives a real one for
  # the tailnet name, so nothing has to be exposed publicly.
  if [ ! -s "$crt" ] || [ -n "$(find "$crt" -mtime +30 2>/dev/null)" ]; then
    info "getting a TLS certificate for $name …"
    tailscale cert --cert-file "$crt" --key-file "$key" "$name" >/dev/null 2>&1 \
      || die "tailscale cert failed (enable HTTPS for your tailnet in the admin console)"
  fi
  : > "$LOGFILE"; rm -f "$PIDFILE"
  PM_CERT="$crt" PM_KEY="$key" PM_PUBLIC_URL="https://$name:$port" PM_PORT="$port" PM_SINK="$SINK" PM_BIND="$ip" \
    PM_PIDFILE="$PIDFILE" setsid nohup python3 "$PREFIX/lib/webmic.py" >>"$LOGFILE" 2>&1 &
  local i; for i in $(seq 1 20); do [ -s "$PIDFILE" ] && break; sleep 0.25; done
  sleep 1
  running || { bad "server failed to start:"; tail -5 "$LOGFILE" | sed 's/^/      /'; rm -f "$PIDFILE"; return 1; }

  local url="https://$name:$port/"
  say ""
  ok "$LABEL ${B}listening${Z}  ${DIM}on $ip:$port (tailnet only, not public)${Z}"
  say ""
  say "  ${B}Open this on the phone${Z} (Tailscale must be connected there):"
  say ""
  say "  ${C}$url${Z}"
  say ""
  command -v qrencode >/dev/null && qrencode -t ANSIUTF8 -m 2 "$url"
  say "  Run ${B}phonemic browser pair${Z} and enter its code on the phone."
  say "  Keep the page open and the screen on -- Android cuts audio from"
  say "  backgrounded tabs."
  say ""
  info "Select ${B}$LABEL${Z} as the input in your app. Stop with: ${B}phonemic off $SLOT${Z}"
  notify "$LABEL" "waiting for the phone"
}

# ---------- persistence (systemd user service) ----------
cmd_persist() {
  load_conf
  command -v ffmpeg >/dev/null || die "ffmpeg is required (sudo apt install ffmpeg)"
  python3 -c "import websockets" 2>/dev/null || die "python websockets missing (pip install --user websockets)"
  [ -f "$PREFIX/lib/webmic.py" ] || die "$PREFIX/lib/webmic.py missing -- run install.sh"

  umask 077
  # Preserve the configured LAN listener and authentication paths when rerun.
  python3 - "$CONF_DIR/web.env" "${WEB_PORT:-8444}" "${WEB_HOST:-}" <<'PYCONF'
import pathlib, sys
path = pathlib.Path(sys.argv[1])
lines = path.read_text().splitlines() if path.exists() else []
lines = [line for line in lines if not line.startswith('PM_TOKEN=')]
keys = {line.split('=', 1)[0] for line in lines if '=' in line}
for key, value in {'PM_PORT': sys.argv[2], 'PM_BIND': '127.0.0.1', 'PM_SINK': 'phonemic2'}.items():
    if key not in keys:
        lines.append(key + '=' + value)
if sys.argv[3] and 'PM_PUBLIC_URL' not in keys:
    lines.append('PM_PUBLIC_URL=https://' + sys.argv[3])
path.write_text('\n'.join(lines) + '\n')
path.chmod(0o600)
PYCONF

  mkdir -p "$HOME/.config/systemd/user"
  cat > "$HOME/.config/systemd/user/$WEB_UNIT" <<'EOF'
[Unit]
Description=PhoneMic web microphone receiver
After=network-online.target pipewire.service
Wants=network-online.target

[Service]
Type=simple
# Plain HTTP on loopback; a TLS-terminating tunnel sits in front.
EnvironmentFile=%h/.config/phonemic/web.env
ExecStart=/usr/bin/python3 %h/.local/share/phonemic/lib/webmic.py
NoNewPrivileges=yes
RestrictSUIDSGID=yes
UMask=0077
LimitCORE=0
Restart=always
RestartSec=5s

[Install]
WantedBy=default.target
EOF
  systemctl --user daemon-reload
  systemctl --user enable --now "$WEB_UNIT" >/dev/null 2>&1
  sleep 2
  if [ "$(systemctl --user is-active "$WEB_UNIT")" = active ]; then
    ok "$WEB_UNIT is running and enabled at boot"
  else
    bad "service failed to start:"
    journalctl --user -u "$WEB_UNIT" -n 8 --no-pager | sed 's/^/      /'
    return 1
  fi

  if [ "$(loginctl show-user "$USER" --property=Linger --value 2>/dev/null)" != yes ]; then
    warn "User lingering is off, so the service stops when you log out."
    warn "Turn it on with:  ${B}sudo loginctl enable-linger $USER${Z}"
  fi
  say ""
  info "Next: expose it with ${B}phonemic tunnel <hostname>${Z}, or reach it locally"
  info "at http://127.0.0.1:${WEB_PORT:-8444}/"
}

# ---------- permanent Cloudflare tunnel ----------
CF_DIR="$HOME/.config/cloudflared"
CF_TUNNEL="phonemic"
CF_UNIT="phonemic-cloudflare-tunnel.service"

cmd_tunnel() {
  local host="${1:-}"
  [ -n "$host" ] || die "usage: phonemic tunnel <hostname>   e.g. mic.example.com"
  command -v cloudflared >/dev/null || die "cloudflared not found"
  [ -s "$HOME/.cloudflared/cert.pem" ] || die "run: cloudflared tunnel login"
  load_conf

  local id
  id=$(cloudflared tunnel list 2>/dev/null | awk -v n="$CF_TUNNEL" '$2==n {print $1; exit}')
  if [ -z "$id" ]; then
    info "creating tunnel '$CF_TUNNEL' …"
    cloudflared tunnel create "$CF_TUNNEL" >/dev/null 2>&1 || die "could not create the tunnel"
    id=$(cloudflared tunnel list 2>/dev/null | awk -v n="$CF_TUNNEL" '$2==n {print $1; exit}')
    [ -n "$id" ] || die "tunnel created but not listed"
  fi
  ok "tunnel $CF_TUNNEL ($id)"

  mkdir -p "$CF_DIR"
  cat > "$CF_DIR/phonemic.yml" <<EOF
tunnel: $id
credentials-file: $HOME/.cloudflared/$id.json
metrics: 127.0.0.1:20243

ingress:
  - hostname: $host
    service: http://127.0.0.1:8444
  - service: http_status:404
EOF
  ok "config written to $CF_DIR/phonemic.yml"

  info "pointing $host at the tunnel …"
  if ! cloudflared tunnel route dns "$CF_TUNNEL" "$host" 2>&1 | tail -2 | sed 's/^/      /'; then
    warn "DNS route failed -- is $host inside a zone on this Cloudflare account?"
  fi

  cat > "$HOME/.config/systemd/user/$CF_UNIT" <<EOF
[Unit]
Description=PhoneMic Cloudflare Tunnel
After=network-online.target phonemic-web.service
Wants=network-online.target
Requires=phonemic-web.service

[Service]
Type=simple
ExecStart=$(command -v cloudflared) --config $CF_DIR/phonemic.yml tunnel run
Restart=always
RestartSec=5s

[Install]
WantedBy=default.target
EOF
  systemctl --user daemon-reload
  systemctl --user enable --now "$CF_UNIT" >/dev/null 2>&1
  sleep 4
  if [ "$(systemctl --user is-active "$CF_UNIT")" = active ]; then
    ok "tunnel service running and enabled at boot"
  else
    bad "tunnel service failed:"; journalctl --user -u "$CF_UNIT" -n 6 --no-pager | sed 's/^/      /'
    return 1
  fi

  WEB_HOST="$host"; save_conf
  python3 - "$CONF_DIR/web.env" "$host" <<'PYORIGIN'
import pathlib, sys
path = pathlib.Path(sys.argv[1])
lines = path.read_text().splitlines() if path.exists() else []
lines = [line for line in lines if not line.startswith('PM_PUBLIC_URL=')]
lines.append('PM_PUBLIC_URL=https://' + sys.argv[2])
path.write_text('\n'.join(lines) + '\n')
path.chmod(0o600)
PYORIGIN
  systemctl --user restart phonemic-web.service 2>/dev/null
  say ""
  ok "Permanent URL:"
  say "  ${C}https://$host/${Z}"
  say ""
  info "Browser pairing is required. Run ${B}phonemic browser pair${Z} on this computer."
  say ""
}

# ---------- one-time USB seeding for a remote phone ----------
cmd_seed() {
  find_adb || die "adb not found"
  load_conf
  say ""
  say "  This opens adb port $ADB_PORT on a phone so you can use it later over"
  say "  Wi-Fi or Tailscale with ${B}no cable${Z}. Mobile data is fine -- the Wi-Fi"
  say "  requirement only applies to Android's 'Wireless debugging' screen."
  say ""
  phone_steps_usb
  local s tries=0
  while :; do
    s=$(pick_usb_device); [ -n "$s" ] && break
    tries=$((tries+1))
    [ "$tries" -gt 30 ] && die "no phone appeared over USB"
    sleep 2
  done
  local model; model=$("$ADB" -s "$s" shell getprop ro.product.model 2>/dev/null | tr -d '\r')
  ok "found ${model:-phone} ($s)"
  info "opening port $ADB_PORT …"
  seed_tcpip "$s" || die "could not open the port"
  ok "port $ADB_PORT is open on ${model:-the phone}"

  local ip name online relay found=""
  while IFS=$'\t' read -r ip name online relay; do
    printf '  · testing %s over Tailscale (%s) … ' "$name" "$ip"
    if try_connect "$ip:$ADB_PORT"; then
      printf '%sreachable%s\n' "$G" "$Z"; ADDR2="$ip:$ADB_PORT"; found=1
    else printf '%snot yet%s\n' "$Y" "$Z"; fi
  done < <(tailscale_android)
  save_conf

  say ""
  if [ -n "$found" ]; then
    ok "You can unplug it. Use it with:  ${B}phonemic on 2${Z}"
  else
    warn "Not reachable over the tailnet yet -- unplug it, make sure Tailscale is"
    warn "connected on the phone, then run:  ${B}phonemic doctor${Z}"
  fi
  say "  ${DIM}Note: port $ADB_PORT stays open until the phone reboots. It is exposed on${Z}"
  say "  ${DIM}any network the phone joins, though Android still requires your${Z}"
  say "  ${DIM}authorised key to connect. Redo this after a reboot.${Z}"
  say ""
}

# ---------- network mode (no adb, no pairing) ----------
# A phone app that runs its own HTTP server binds to every interface, so it is
# reachable over Tailscale -- unlike adbd, which is why pairing is not needed
# here at all.
cmd_net() {
  load_conf; use_slot "${2:-2}"
  local url="${1:-${NET_URL:-}}" ip name online relay
  if [ -z "$url" ]; then
    while IFS=$'\t' read -r ip name online relay; do
      url="http://$ip:8080/audio.wav"
      info "using $name at $ip ($relay)"
    done < <(tailscale_android)
  fi
  [ -n "$url" ] || die "no URL and no Android device on your tailnet. Usage: phonemic net <url>"

  vmic_present || die "virtual microphone missing. Run: phonemic setup"
  running && { warn "$LABEL already running -- restarting it"; cmd_off "$SLOT" >/dev/null; use_slot "$SLOT"; }

  info "checking $url …"
  # A live stream never ends, so curl always "times out" -- judge it by the HTTP
  # status, not the exit code. --limit-rate keeps the probe off your data plan.
  local code
  code=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 3 --limit-rate 100k "$url" 2>/dev/null)
  case "$code" in
    2*) ok "stream is reachable (HTTP $code)" ;;
    000)
      bad "nothing answered at $url"
      case "$url" in
        *100.*) android_inbound_note ;;
        *) say ""; say "  Start the streaming server on the phone first:"; phone_steps_net ;;
      esac
      return 1 ;;
    *)
      bad "the phone answered with HTTP $code -- wrong path, most likely."
      say "  Try one of: ${B}/audio.wav${Z}  ${B}/audio.opus${Z}  ${B}/audio.aac${Z}"
      say "  e.g. phonemic net http://${url#http://}" 
      say "  (IP Webcam serves /audio.wav; other apps differ.)"
      return 1 ;;
  esac

  : > "$LOGFILE"
  nohup ffmpeg -hide_banner -loglevel warning -nostdin \
      -fflags nobuffer -flags low_delay -probesize 32 -analyzeduration 0 \
      -i "$url" -f pulse -device "$SINK" phonemic-net \
      >>"$LOGFILE" 2>&1 &
  echo $! > "$PIDFILE"
  NET_URL="$url"; save_conf
  sleep 3

  if ! running; then
    bad "the stream stopped. Last lines:"; tail -4 "$LOGFILE" | sed 's/^/      /'
    rm -f "$PIDFILE"; return 1
  fi
  ROUTED_TO=""
  if route_stream "$(cat "$PIDFILE")"; then ok "routed to the virtual microphone"
  else warn "audio is on '${ROUTED_TO:-unknown}', not PhoneMic"; fi
  ok "$LABEL ${B}on${Z}  ${DIM}via network · $url${Z}"
  info "Select ${B}$LABEL${Z} as the input device in your app."
  notify "$LABEL on" "network stream"
}

phone_steps_net() {
  cat <<EOF

${B}On your phone -- stream the mic with no cable and no pairing${Z}

  1. Install ${B}IP Webcam${Z} (free, Play Store)
  2. Open it and scroll to the bottom → ${B}Start server${Z}
     ${DIM}Optional: Video preferences → turn OFF video to save battery,${Z}
     ${DIM}and set Audio mode to "Audio only".${Z}
  3. The screen shows a URL like http://<PHONE_IP>:8080
     Only the ${B}port${Z} matters -- normally ${B}8080${Z}.
  4. Keep Tailscale connected on the phone.

  Then on the laptop:  ${B}phonemic net${Z}
EOF
}

# ---------- pairing (cable-free, incl. over Tailscale) ----------
cmd_pair() {
  find_adb || die "adb not found"
  local host="${1:-}" ip name online relay

  if [ -z "$host" ]; then
    while IFS=$'\t' read -r ip name online relay; do
      host="$ip"
      say "  Using ${B}$name${Z} on your tailnet ($ip, $relay)."
    done < <(tailscale_android)
  fi

  cat <<EOF

${B}On the phone${Z}
  1. Settings → Additional settings → Developer options
     ${DIM}(or search Settings for: developer)${Z}
  2. Turn on ${B}Wireless debugging${Z}
     ${DIM}The phone must be on Wi-Fi -- Android greys this out on mobile data.${Z}
  3. Tap the words ${B}Wireless debugging${Z} to open it
  4. Tap ${B}Pair device with pairing code${Z}
  5. Leave that screen open. It shows:
        IP address & Port   e.g. <PHONE_IP>:37115
        Wi-Fi pairing code  e.g. 123456

EOF
  printf '%s  Pairing PORT (the number after the colon) ›%s ' "$C" "$Z"; read -r pport </dev/tty
  printf '%s  Pairing CODE (6 digits) ›%s ' "$C" "$Z"; read -r pcode </dev/tty
  [ -n "$pport" ] && [ -n "$pcode" ] || die "need both the port and the code"

  say ""
  info "pairing with $host:$pport …"
  if ! "$ADB" pair "$host:$pport" "$pcode" 2>&1 | tee /dev/stderr | grep -q 'Successfully paired'; then
    bad "pairing failed."
    say "    · If it says 'failed to connect': the phone is refusing connections on"
    say "      that interface. Wireless debugging may only be listening on Wi-Fi,"
    say "      not on the Tailscale interface -- try again on the same Wi-Fi first."
    say "    · The pairing code expires quickly. Reopen the pairing screen and retry."
    return 1
  fi
  ok "paired"

  say ""
  say "  Now go ${B}back one screen${Z} to the main Wireless debugging page."
  say "  It shows a ${B}different${Z} port under 'IP address & Port'."
  printf '%s  Connect PORT ›%s ' "$C" "$Z"; read -r cport </dev/tty
  [ -n "$cport" ] || die "need the connect port"

  info "connecting to $host:$cport …"
  if try_connect "$host:$cport"; then
    ADDR="$host:$cport"; save_conf
    ok "connected -- saved as $ADDR"
    say ""
    info "Run ${B}phonemic on${Z} to start using it as a microphone."
  else
    bad "could not connect to $host:$cport"
    return 1
  fi
}

# ---------- setup wizard ----------
cmd_setup() {
  head1 "PhoneMic setup"
  say "  Turns a phone into a microphone for this computer."
  say "  Two independent inputs:"
  say "    ${B}PhoneMic${Z}    a phone on a USB cable (best quality, lowest latency)"
  say "    ${B}PhoneMic-2${Z}  any phone's browser, over the internet"
  say ""

  head1 "1/4  Checking this computer"
  audio_server_ok || die "setup stopped"
  ok "PipeWire is running"
  command -v ffmpeg >/dev/null && ok "ffmpeg" || die "install ffmpeg: sudo apt install ffmpeg"
  python3 -c "import websockets" 2>/dev/null && ok "python websockets" \
    || die "install it: pip install --user websockets"
  if find_adb; then ok "adb: $ADB"; else info "adb not found -- the USB phone will be skipped"; fi

  head1 "2/4  Virtual microphones"
  install_vmic || die "setup stopped"

  head1 "3/4  Web receiver (the internet phone)"
  cmd_persist || die "setup stopped"

  head1 "4/4  USB phone (optional)"
  if find_adb; then
    printf '%s  Set up a phone on a USB cable now? [y/N] ›%s ' "$C" "$Z"
    local a; read -r a </dev/tty
    case "$a" in
      [Yy]*)
        install_scrcpy || warn "scrcpy install failed; the USB phone will not work"
        phone_steps_dev; pause
        phone_steps_usb; pause
        local sv; sv=$(pick_usb_device)
        if [ -n "$sv" ]; then ok "phone connected ($sv)"; AUDIO_SOURCE=$(pick_audio_source); save_conf
          ok "microphone mode: $AUDIO_SOURCE"
        else warn "no phone found over USB -- run 'phonemic doctor' later"; fi ;;
      *) info "skipped. Run ${B}phonemic setup${Z} again any time." ;;
    esac
  else
    info "skipped (no adb installed)"
  fi

  head1 "Done"
  say "  ${B}Internet phone${Z} (works anywhere, including mobile data):"
  say "    phonemic tunnel mic.example.com   ${DIM}# one time, needs a Cloudflare domain${Z}"
  say "    then open the printed link on the phone and install it as an app"
  say ""
  say "  ${B}USB phone:${Z}"
  say "    phonemic on          ${DIM}# start   (phonemic off to stop)${Z}"
  say ""
  say "  ${B}Check it works:${Z}"
  say "    phonemic test 1      ${DIM}# level meter for PhoneMic${Z}"
  say "    phonemic test 2      ${DIM}# level meter for PhoneMic-2${Z}"
  say ""
  say "  In any app, pick ${B}PhoneMic${Z} or ${B}PhoneMic-2${Z} as the input device."
  say "  ${DIM}Wear headphones, or the phone will pick up your speakers.${Z}"
  say ""
}

cmd_uninstall() {
  cmd_off >/dev/null 2>&1
  local u
  for u in "$WEB_UNIT" "$CF_UNIT"; do
    if systemctl --user cat "$u" >/dev/null 2>&1; then
      systemctl --user disable --now "$u" >/dev/null 2>&1
      rm -f "$HOME/.config/systemd/user/$u"
      ok "removed $u"
    fi
  done
  systemctl --user daemon-reload

  rm -f "$PW_CONF" "$PP_CONF"
  systemctl --user restart pipewire pipewire-pulse wireplumber 2>/dev/null
  rm -rf "$PREFIX" "$CONF_DIR"
  ok "removed. Your normal audio is untouched."

  if [ -f "$CF_DIR/phonemic.yml" ]; then
    say ""
    warn "The Cloudflare tunnel and its DNS record still exist. Remove them with:"
    say "    cloudflared tunnel delete $CF_TUNNEL"
    say "    ${DIM}(and delete the CNAME in the Cloudflare dashboard)${Z}"
    rm -f "$CF_DIR/phonemic.yml"
  fi
}

cmd_help() {
  cat <<EOF
${B}phonemic${Z} - use your Android phone as this laptop's microphone

  ${B}phonemic${Z}              toggle the USB phone on/off
  ${B}phonemic on${Z}           USB/adb phone   -> input "PhoneMic"
  ${B}phonemic on 2${Z}         adb phone over Wi-Fi -> "PhoneMic-2"  ${DIM}(same network only)${Z}
  ${B}phonemic seed${Z}         one USB session to enable a phone for cable-free use
  ${B}phonemic web${Z}          INTERNET: phone's browser streams to us -> "PhoneMic-2"
  ${B}phonemic browser pair|status|revoke${Z}  manage the one approved browser
  ${B}phonemic persist${Z}      run the web receiver as a service, start at boot
  ${B}phonemic tunnel HOST${Z}  permanent public URL via Cloudflare (one time)
  ${B}phonemic net${Z}          pull from a phone app     ${DIM}(same network only)${Z}
  ${B}phonemic off${Z}          stop both   (${B}off 1${Z} / ${B}off 2${Z} for one)
  ${B}phonemic test 1|2${Z}     live level meter for that mic
  ${B}phonemic setup${Z}        first-time guided setup
  ${B}phonemic pair${Z}         adb over Wi-Fi, no cable  ${DIM}(same network only)${Z}
  ${B}phonemic status${Z}       current state
  ${B}phonemic doctor${Z}       diagnose connection problems
  ${B}phonemic phone${Z}        reprint the phone-side instructions
  ${B}phonemic uninstall${Z}    remove everything

Two phones at once, as independent inputs that can run simultaneously.
Slot 1 = the cabled phone, slot 2 = a remote one over Wi-Fi or Tailscale
(mobile data is fine; "seed" it once over USB first). "net" is the no-adb
fallback for slot 2 when you cannot seed the phone.
EOF
}

load_conf; find_adb
case "${1:-toggle}" in
  setup) cmd_setup ;;
  browser) shift; python3 "$PREFIX/lib/webauth.py" "${@:-status}" ;;
  pair) shift; cmd_pair "${1:-}" ;;
  net) shift; cmd_net "${1:-}" "${2:-2}" ;;
  on|usb) shift; cmd_on "${1:-1}" ;;
  seed) cmd_seed ;;
  persist) cmd_persist ;;
  tunnel) shift; cmd_tunnel "${1:-}" ;;
  web) shift; cmd_web "${1:-2}" ;;
  off) shift; cmd_off "${1:-}" ;;
  toggle) cmd_toggle ;;
  status) cmd_status ;;
  doctor) cmd_doctor ;;
  test) shift; cmd_test "${1:-1}" ;;
  phone) cmd_phone ;;
  uninstall) cmd_uninstall ;;
  -h|--help|help) cmd_help ;;
  *) bad "unknown command: $1"; cmd_help; exit 1 ;;
esac
